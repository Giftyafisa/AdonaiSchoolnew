# Client (Vite build-time) — used by src/integrations/supabase/client.ts
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server (SSR / server functions) — used by client.server.ts and auth middleware
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# When deploying through Lovable Cloud these are injected automatically;
# for local development copy this file to .env and fill in real values.
